# MongoDB local
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=courtroom_ai

# Vector store (relative to repo root)
CHROMA_DB_PATH=storage/chroma_db

# Ollama settings (embeddings + local generation fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_GENERATION_MODEL=qwen2.5:3b
OLLAMA_GENERATION_TIMEOUT=180

# Google Gemini embeddings (per-user document uploads only; master KB stays on Ollama)
GOOGLE_API_KEY=your_google_api_key_here
EMBEDDING_PROVIDER=google
GOOGLE_EMBED_MODEL=models/gemini-embedding-001
GOOGLE_EMBED_BATCH=64

# Telemetry
ANONYMIZED_TELEMETRY=False

# App settings
LANGUAGE=en
LOG_LEVEL=INFO

# React Frontend Environment Variables
REACT_APP_API_URL=http://localhost:8000

# Groq API Settings (Primary generation & advocate drafting engine)
GROQ_ENABLED=1
GROQ_API_KEY=your_groq_api_key_here
GROQ_GENERATION_MODEL=qwen/qwen3.8-27b
GROQ_DRAFTING_MODEL=qwen/qwen3.8-27b
GROQ_TRANSLATE_MODEL=qwen/qwen3.8-27b
GROQ_TRANSLATION_ENABLED=1
GROQ_SSL_VERIFY=0
GROQ_GENERATION_MAX_TOKENS=1024
GROQ_GENERATION_TIMEOUT=60
GROQ_DRAFTING_TIMEOUT=8.0

# Translation QA (disabled: Groq quality is sufficient)
TRANSLATION_QA_SKIP_GROQ=1
TRANSLATION_QA_TIMEOUT=6

# Auth
SECRET_KEY=your-secret-key-change-in-production

# Stripe (Optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Email (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your_app_password
